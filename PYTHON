def find_and_click_learn_more_below_100(driver):

    try:
        WebDriverWait(driver, 10).until(
            EC.presence_of_element_located((By.CLASS_NAME, "item-area"))
        )

        product_containers = driver.find_elements(By.CLASS_NAME, "item-area")

        target_products = [
            container for container in product_containers if price_below_100(container)
        ]

        if target_products:
            first_cheap_product = target_products[0]
            details_button = first_cheap_product.find_element(By.XPATH, "//button[@class='button' and contains(text(),'Details')]")

            details_button.click()
            return True
        else:
            print("No products below $100 found.")
            return False

    except (NoSuchElementException, TimeoutException, StaleElementReferenceException) as e:
        print(f"Error finding or clicking product: {e}")
        return False


def price_below_100(product_container):

    try:
    
        price_element = product_container.find_element(By.CLASS_NAME, "price")

        price_text = price_element.text.strip()
        if price_text.startswith("</span>"):  
            price_text = price_text[7:]  
        price_value = float(price_text.strip("$"))  

        # Return True if price is below $100
        return price_value < 50
    
    except NoSuchElementException:
        
        print("Price element not found for product.")
        return False

def capture_full_page_screenshot(driver, screenshot_path):
    web_page_height = driver.execute_script("""
        return Math.max(
            document.body.scrollHeight,
            document.body.offsetHeight,
            document.documentElement.clientHeight,
            document.documentElement.scrollHeight,
            document.documentElement.offsetHeight
        );
    """)
    driver.set_window_size(1366, web_page_height)
    whole_page = driver.find_element(By.TAG_NAME, "body")
    whole_page.screenshot(screenshot_path)


